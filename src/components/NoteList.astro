---
import { isWip, type Note } from "../lib/notes";
import StatusBadge from "./StatusBadge.astro";
import { noteDates, formatDate, sortByCreatedDesc } from "../lib/dates";

interface Props {
  notes: Note[];
  basePath: string;
  /** 渡された順のまま表示する(シリーズ順など、作成日順にしたくないとき) */
  presorted?: boolean;
  /** 「第N回」を表示する(シリーズ一覧用) */
  numbered?: boolean;
}

const { notes, basePath, presorted = false, numbered = false } = Astro.props;
const sorted = presorted ? notes : sortByCreatedDesc(notes);
---

{
  sorted.length === 0 ? (
    <p class="empty">まだメモがありません。</p>
  ) : (
    <ul class="note-list">
      {sorted.map((note, index) => {
        const { created } = noteDates(note);
        return (
          <li>
            <a href={`${basePath}${note.id}/`} class="note-link">
              {(numbered || isWip(note)) && (
                <span class="note-meta">
                  <StatusBadge note={note} />
                  {numbered && <span class="note-number">第{index + 1}回</span>}
                </span>
              )}
              <span class="note-title">{note.data.title}</span>
              {note.data.description && (
                <span class="note-description">{note.data.description}</span>
              )}
              <time class="note-date" datetime={created.toISOString()}>
                {formatDate(created)}
              </time>
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .empty {
    color: var(--text-muted);
  }
  .note-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .note-link {
    display: block;
    padding: 20px 24px;
    color: inherit;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }
  .note-link:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-3);
  }
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .note-number {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .note-title {
    display: block;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .note-description {
    display: block;
    margin-top: 6px;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .note-date {
    display: block;
    margin-top: 10px;
    color: var(--text-faint);
    font-size: 0.85rem;
  }
</style>
