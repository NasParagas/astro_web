---
import type { CollectionEntry } from "astro:content";
import { noteDates, formatDate, sortByCreatedDesc } from "../lib/dates";

interface Props {
  notes: (CollectionEntry<"dev"> | CollectionEntry<"recipe">)[];
  basePath: string;
}

const { notes, basePath } = Astro.props;
const sorted = sortByCreatedDesc(notes);
---

{
  sorted.length === 0 ? (
    <p class="empty">まだメモがありません。</p>
  ) : (
    <ul class="note-list">
      {sorted.map((note) => {
        const { created } = noteDates(note);
        return (
          <li>
            <a href={`${basePath}${note.id}/`} class="note-link">
              <span class="note-title">{note.data.title}</span>
              {note.data.description && (
                <span class="note-description">{note.data.description}</span>
              )}
              <time class="note-date" datetime={created.toISOString()}>
                {formatDate(created)}
              </time>
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .empty {
    color: #64748b;
  }
  .note-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .note-link {
    display: block;
    padding: 20px 24px;
    color: inherit;
    text-decoration: none;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }
  .note-link:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
    box-shadow: 0 12px 30px rgb(15 23 42 / 0.08);
  }
  .note-title {
    display: block;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .note-description {
    display: block;
    margin-top: 6px;
    color: #64748b;
    line-height: 1.7;
  }
  .note-date {
    display: block;
    margin-top: 10px;
    color: #94a3b8;
    font-size: 0.85rem;
  }
</style>
