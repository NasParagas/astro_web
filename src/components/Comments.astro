---
// giscus (https://giscus.app) のコメント欄。
// コメントはGitHubリポジトリ NasParagas/astro_web のDiscussions
// (Announcementsカテゴリ) に保存される。
//
// 記事との紐づけはmapping="specific"で、ビルド時に決めたtermを使う。
// giscus任せのpathname mappingだと記事のURLを変えた瞬間に過去のコメントが
// 見えなくなるため、termをfrontmatter(commentTerm)で固定できるようにしている。
// 既存のDiscussionと互換を保つため、デフォルト値はpathname mapping時代と同じ
// 「末尾スラッシュ付きのパス」にしてある。

interface Props {
  term?: string;
}

const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const term = Astro.props.term ?? pathname;
---

<section class="comments" data-term={term}>
  {/*
    giscusはiframeの中で描画されるのでCSS変数が届かない。
    そのため読み込み時にテーマを渡し、切り替え時はpostMessageで伝える。
    scriptタグを直接書くとdata-themeを静的にしか指定できないので、
    現在のテーマを見てから組み立てている。
  */}
  <script is:inline>
    (function () {
      var section = document.currentScript.parentElement;
      var giscusTheme = function () {
        return document.documentElement.dataset.theme === "dark"
          ? "dark"
          : "light";
      };

      var script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      script.async = true;
      script.crossOrigin = "anonymous";
      var attrs = {
        "data-repo": "NasParagas/astro_web",
        "data-repo-id": "R_kgDORsvREg",
        "data-category": "Announcements",
        "data-category-id": "DIC_kwDORsvREs4DBccb",
        "data-mapping": "specific",
        "data-term": section.dataset.term,
        "data-strict": "0",
        "data-reactions-enabled": "1",
        "data-emit-metadata": "0",
        "data-input-position": "bottom",
        "data-theme": giscusTheme(),
        "data-lang": "ja",
        "data-loading": "lazy",
      };
      for (var name in attrs) script.setAttribute(name, attrs[name]);
      section.appendChild(script);

      document.addEventListener("themechange", function () {
        var frame = section.querySelector("iframe.giscus-frame");
        if (!frame) return;
        frame.contentWindow.postMessage(
          { giscus: { setConfig: { theme: giscusTheme() } } },
          "https://giscus.app",
        );
      });
    })();
  </script>
</section>

<style>
  .comments {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
</style>
