---
// giscus (https://giscus.app) のコメント欄。
// コメントはGitHubリポジトリ NasParagas/astro_web のDiscussions
// (Announcementsカテゴリ) に保存される。
//
// 記事との紐づけはmapping="specific"で、ビルド時に決めたtermを使う。
// giscus任せのpathname mappingだと記事のURLを変えた瞬間に過去のコメントが
// 見えなくなるため、termをfrontmatter(commentTerm)で固定できるようにしている。
// 既存のDiscussionと互換を保つため、デフォルト値はpathname mapping時代と同じ
// 「末尾スラッシュ付きのパス」にしてある。

interface Props {
  term?: string;
}

const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const term = Astro.props.term ?? pathname;
---

<section class="comments">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="NasParagas/astro_web"
    data-repo-id="R_kgDORsvREg"
    data-category="Announcements"
    data-category-id="DIC_kwDORsvREs4DBccb"
    data-mapping="specific"
    data-term={term}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="light"
    data-lang="ja"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</section>

<style>
  .comments {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid #e5e7eb;
  }
</style>
