---
import { noteTags, type Note } from "../lib/notes";

interface Props {
  note: Note;
}

const { note } = Astro.props;
const tags = noteTags(note);
// 日本語のタグでもリンクが壊れないようにエンコードしておく
const tagHref = (tag: string) =>
  `/${note.collection}/tags/${encodeURIComponent(tag)}/`;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          <a href={tagHref(tag)}>#{tag}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 12px 0 0;
    list-style: none;
  }
  .tags a {
    display: block;
    padding: 2px 10px;
    color: var(--text-body);
    font-size: 0.8rem;
    text-decoration: none;
    background: var(--surface-alt);
    border: 1px solid var(--surface-strong);
    border-radius: 999px;
  }
  .tags a:hover {
    color: var(--text-strong);
    background: var(--surface-strong);
  }
</style>
