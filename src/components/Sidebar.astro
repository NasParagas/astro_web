---
import { getCollection } from "astro:content";
import ThemeToggle from "./ThemeToggle.astro";
import { sortByCreatedDesc } from "../lib/dates";
import { isWip } from "../lib/notes";

const sections = [
  { href: "/dev/", label: "dev", notes: sortByCreatedDesc(await getCollection("dev")) },
  { href: "/recipe/", label: "recipe", notes: sortByCreatedDesc(await getCollection("recipe")) },
];

// 末尾スラッシュの有無を揃えてから現在ページと比較する
const current = Astro.url.pathname.replace(/\/+$/, "") + "/";
const ariaCurrent = (href: string) => (current === href ? "page" : undefined);
---

<aside class="sidebar">
  <div class="sidebar-head">
    <a href="/" class="site-name" aria-current={ariaCurrent("/")}>
      NasParagas's home
    </a>
    <ThemeToggle />
  </div>

  {
    sections.map((section) => (
      <nav class="section">
        <a href={section.href} class="section-title" aria-current={ariaCurrent(section.href)}>
          {section.label}
        </a>
        {section.notes.length > 0 && (
          <ul>
            {section.notes.map((note) => (
              <li>
                <a
                  href={`${section.href}${note.id}/`}
                  aria-current={ariaCurrent(`${section.href}${note.id}/`)}
                >
                  {isWip(note) && (
                    <span class="wip-dot" role="img" aria-label="作成中" />
                  )}
                  {note.data.title}
                </a>
              </li>
            ))}
          </ul>
        )}
      </nav>
    ))
  }
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    max-height: 100vh;
    overflow-y: auto;
    padding: 48px 24px;
    border-right: 1px solid var(--border);
  }
  .sidebar-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 32px;
  }
  .site-name {
    display: block;
    color: var(--text-strong);
    font-weight: 700;
    text-decoration: none;
  }
  .site-name:hover {
    text-decoration: underline;
  }
  .section {
    margin-bottom: 28px;
  }
  .section-title {
    display: block;
    margin-bottom: 8px;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .section-title:hover {
    color: var(--text);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  li a {
    display: block;
    padding: 4px 8px;
    color: var(--text-body);
    font-size: 0.9rem;
    line-height: 1.5;
    text-decoration: none;
    border-radius: 8px;
  }
  /* 作成中のメモに付ける小さい印(サイドバーは幅が狭いのでバッジではなく点) */
  .wip-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    vertical-align: middle;
    background: var(--wip-dot);
    border-radius: 50%;
  }
  li a:hover {
    color: var(--text-strong);
    background: var(--surface-alt);
  }
  a[aria-current="page"] {
    color: var(--text-strong);
    font-weight: 600;
  }
  li a[aria-current="page"] {
    background: var(--surface-strong);
  }

  @media (max-width: 768px) {
    .sidebar {
      position: static;
      max-height: none;
      padding: 24px 16px;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
    .sidebar-head {
      margin-bottom: 16px;
    }
    .section {
      margin-bottom: 16px;
    }
  }
</style>
