---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    {/*
      テーマの決定は画面が描かれる前(=head内)にやる必要がある。
      body描画後だとライトで一瞬光ってからダークに切り替わる。
      is:inline なのでバンドルされずそのままインラインで実行される。
    */}
    <script is:inline>
      (function () {
        var theme = "light";
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") {
            theme = saved;
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            // 未選択のうちはOSの設定に従う
            theme = "dark";
          }
        } catch (e) {
          // プライベートモードなどでlocalStorageが読めない場合はライトのまま
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="layout">
      <Sidebar />
      <main class="content">
        <slot />
      </main>
    </div>
  </body>
</html>
