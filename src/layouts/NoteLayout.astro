---
import BaseLayout from "./BaseLayout.astro";
import Comments from "../components/Comments.astro";
import SeriesNav from "../components/SeriesNav.astro";
import StatusBadge from "../components/StatusBadge.astro";
import TagChips from "../components/TagChips.astro";
import { formatDate, noteDates } from "../lib/dates";
import { isWip, type Note } from "../lib/notes";

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { title, description, commentTerm } = note.data;
const { created, updated } = noteDates(note);
// 同じ日のうちの更新は表示しない
const showUpdated = formatDate(updated) !== formatDate(created);
---

<BaseLayout title={`${title} | NasParagas's home`} description={description}>
  <header class="note-header">
    <h1>{title}</h1>
    <p class="date">
      <time datetime={created.toISOString()}>{formatDate(created)}</time>
      {
        showUpdated && (
          <span class="updated">
            (最終更新: <time datetime={updated.toISOString()}>{formatDate(updated)}</time>)
          </span>
        )
      }
      <StatusBadge note={note} />
    </p>
    <TagChips note={note} />
  </header>

  {
    isWip(note) && (
      <p class="wip-notice">このメモは書きかけです。本当にただのメモ書きのような見た目だったり、その内容が変わる可能性があります。</p>
    )
  }

  <article class="prose">
    <slot />
  </article>

  <SeriesNav note={note} />

  <Comments term={commentTerm} />
</BaseLayout>

<style>
  .note-header h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.3;
    color: var(--text-strong);
  }
  .date {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 12px 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .wip-notice {
    padding: 12px 20px;
    margin: 0 0 32px;
    color: var(--wip-text);
    font-size: 0.9rem;
    line-height: 1.7;
    background: var(--wip-notice-bg);
    border: 1px solid var(--wip-border);
    border-radius: 12px;
  }
  .note-header {
    padding-bottom: 24px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }

  /* Markdown本文はスコープ外から来るので :global で当てる */
  .prose {
    line-height: 1.9;
  }
  .prose :global(h2) {
    margin: 2.5em 0 0.75em;
    padding-bottom: 0.3em;
    font-size: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .prose :global(h3) {
    margin: 2em 0 0.5em;
    font-size: 1.2rem;
  }
  .prose :global(p) {
    margin: 1em 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5em;
  }
  .prose :global(li) {
    margin: 0.4em 0;
  }
  .prose :global(code) {
    padding: 0.15em 0.4em;
    font-size: 0.9em;
    background: var(--surface-strong);
    border-radius: 6px;
  }
  .prose :global(pre) {
    padding: 16px 20px;
    overflow-x: auto;
    border-radius: 12px;
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
  }
  .prose :global(blockquote) {
    margin: 1em 0;
    padding: 0.25em 1.25em;
    color: var(--text-body);
    border-left: 4px solid var(--border-strong);
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 6px 12px;
    border: 1px solid var(--border);
  }
</style>
