---
import BaseLayout from "../layouts/BaseLayout.astro";

const pages = [
  { href: "/dev/", label: "dev", description: "技術メモなど" },
  { href: "/recipe/", label: "recipe", description: "料理メモなど" },
];
---

<BaseLayout
  title="NasParagas's home"
  description="技術メモ、学習記録、料理の記録などをまとめる場所です。"
>
  <section class="hero">
    <p class="eyebrow">NasParagas's home</p>
    <h1>こんにちは</h1>
    <p class="lead">技術メモ、学習記録、料理の記録などをまとめる場所です。</p>
  </section>

  <nav class="nav">
    <ul>
      {
        pages.map((page) => (
          <li>
            <a href={page.href} class="card">
              <span class="card-title">{page.label}</span>
              <span class="card-description">{page.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>

<style>
  .hero h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 1;
  }
  .nav ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .card {
    display: block;
    min-height: 140px;
    padding: 24px;
    color: inherit;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow-2);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-4);
  }
  .card-title {
    display: block;
    margin-bottom: 12px;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .card-description {
    display: block;
    color: var(--text-muted);
    line-height: 1.7;
  }
</style>
