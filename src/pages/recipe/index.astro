---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteList from "../../components/NoteList.astro";

const notes = await getCollection("recipe");
---

<BaseLayout title="recipe | NasParagas's home" description="料理メモなど">
  <header class="hero">
    <p class="eyebrow">recipe</p>
    <h1>料理メモ</h1>
    <nav class="sub-nav">
      <a href="/recipe/series/">シリーズ</a>
      <a href="/recipe/tags/">タグ</a>
    </nav>
  </header>

  <NoteList notes={notes} basePath="/recipe/" />
</BaseLayout>
