---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NoteList from "../../../components/NoteList.astro";
import { collectTags, notesWithTag } from "../../../lib/notes";

export async function getStaticPaths() {
  const notes = await getCollection("dev");
  return collectTags(notes).map(({ tag }) => ({
    params: { tag },
    props: { tag, notes: notesWithTag(notes, tag) },
  }));
}

const { tag, notes } = Astro.props;
---

<BaseLayout
  title={`#${tag} | dev | NasParagas's home`}
  description={`#${tag} が付いた技術メモ`}
>
  <header class="hero">
    <p class="eyebrow"><a href="/dev/tags/">タグ</a></p>
    <h1>#{tag}</h1>
  </header>

  <NoteList notes={notes} basePath="/dev/" />
</BaseLayout>
