---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteList from "../../components/NoteList.astro";

const notes = await getCollection("dev");
---

<BaseLayout title="dev | NasParagas's home" description="技術メモなど">
  <header class="hero">
    <p class="eyebrow">dev</p>
    <h1>技術メモ</h1>
    <nav class="sub-nav">
      <a href="/dev/series/">シリーズ</a>
      <a href="/dev/tags/">タグ</a>
    </nav>
  </header>

  <NoteList notes={notes} basePath="/dev/" />
</BaseLayout>
