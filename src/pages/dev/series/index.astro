---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SeriesIndex from "../../../components/SeriesIndex.astro";

const notes = await getCollection("dev");
---

<BaseLayout
  title="シリーズ | dev | NasParagas's home"
  description="技術メモのシリーズ一覧"
>
  <header class="hero">
    <p class="eyebrow"><a href="/dev/">dev</a></p>
    <h1>シリーズ</h1>
  </header>

  <SeriesIndex notes={notes} basePath="/dev/" />
</BaseLayout>
